# Command Center — server config (set these on the droplet; never commit real values)
CC_USERNAME=chris
CC_PASSWORD=change-me-to-a-strong-password     # turns the login gate ON
CC_INGEST_TOKEN=generate-a-long-random-token   # laptop uploader uses the same value
CC_DATA_DIR=/opt/command_center/data           # where uploaded results land on the server
COMMAND_CENTER_PORT=5055
CC_GEO_FILTER_ENABLED=true                 # default true: only documented Greensboro-area cities are dialable
CC_TARGET_BIRTH_YEARS=1962                 # T65 cohort; use 1961 for calendar-year 2026 T65
CC_MAX_CALL_ATTEMPTS=4                     # once a phone has 4 call attempts, keep it out of the dial queue
CC_RETRYABLE_DISPOSITIONS=no_answer,busy,voicemail_dropped,answering_machine,machine_skipped,false_bridge
# CC_DOMAIN=cc.ncwealthprotection.me           # set for automatic HTTPS via Caddy

# OSCR real-time ingestion daemon (oscr_ingestion_agent.py)
OSCR_STRATEGY=api                           # api or browser
OSCR_OWNER=chris
OSCR_DEFAULT_SOURCE=OSCR
OSCR_DEFAULT_SCORE=100
OSCR_POLL_SECONDS=10
OSCR_MAX_POLL_SECONDS=300
OSCR_REQUEST_TIMEOUT_SECONDS=20
OSCR_GEO_FILTER_ENABLED=true
OSCR_TARGET_BIRTH_YEARS=1962

# Strategy A: API Engine
OSCR_API_URL=
OSCR_API_TOKEN=
OSCR_API_CURSOR_PARAM=since
OSCR_API_CURSOR_FIELD=next_cursor
OSCR_API_LEADS_PATH=leads

# Strategy B: Browser Engine (fill selectors after inspecting OSCR)
OSCR_LOGIN_URL=https://bspn.bankers.com/oscr
OSCR_DASHBOARD_URL=https://bspn.bankers.com/oscr
OSCR_USERNAME=
OSCR_PASSWORD=
OSCR_BROWSER_PROFILE_DIR=/opt/command_center/oscr_profile
OSCR_BROWSER_HEADLESS=true
OSCR_USERNAME_SELECTOR=input[name='username']
OSCR_PASSWORD_SELECTOR=input[name='password']
OSCR_SUBMIT_SELECTOR=button[type='submit']
OSCR_LOGGED_IN_SELECTOR=body
OSCR_LEAD_ROW_SELECTOR=[data-lead-row]
OSCR_BROWSER_SELECTORS_JSON={"oscr_id":"[data-field='oscr_id']","name":"[data-field='name']","phone":"[data-field='phone']","address":"[data-field='address']","city":"[data-field='city']","county":"[data-field='county']","birthday":"[data-field='birthday']","email":"[data-field='email']","campaign":"[data-field='campaign']"}
OSCR_CAMPAIGN_SOURCE_MAP_JSON={}
