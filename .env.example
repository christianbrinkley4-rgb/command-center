# Command Center — server config (set these on the droplet; never commit real values)
CC_USERNAME=chris
CC_PASSWORD=change-me-to-a-strong-password     # turns the login gate ON
CC_INGEST_TOKEN=generate-a-long-random-token   # laptop uploader uses the same value
CC_DATA_DIR=/opt/command_center/data           # where uploaded results land on the server
COMMAND_CENTER_PORT=5055
CC_GEO_FILTER_ENABLED=true                 # default true: only documented Greensboro-area cities are dialable
CC_TARGET_BIRTH_YEARS=1962                 # T65 cohort; use 1961 for calendar-year 2026 T65
# CC_DOMAIN=cc.ncwealthprotection.me           # set for automatic HTTPS via Caddy
